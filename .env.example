# --- Supabase (obligatorio) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Solo servidor: lo usa el webhook de pagos para activar Premium. Nunca exponerlo.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# URL pública canónica (sin barra final). Se usa en SEO, sitemap, links para compartir y Mercado Pago.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google AdSense (opcional) ---
# Sin estas variables se muestran anuncios propios que invitan a crear torneos.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# NEXT_PUBLIC_ADSENSE_SLOT_TOP=0000000000
# NEXT_PUBLIC_ADSENSE_SLOT_INLINE=0000000000
# NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=0000000000

# --- Mercado Pago / Premium (opcional) ---
MERCADOPAGO_ACCESS_TOKEN=YOUR_MERCADOPAGO_ACCESS_TOKEN
MP_WEBHOOK_SECRET=YOUR_MERCADOPAGO_WEBHOOK_SECRET
PREMIUM_PRICE_ARS=2500
